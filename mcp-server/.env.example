# Betgistics MCP Server Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb://localhost:27017/betgistics

# Google Gemini AI API Key (for AI probability estimation)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://chatgpt.com

# Debug Mode
# Set to 1 to enable verbose MCP logging
DEBUG_MCP=0

# Admin / automation
# ADMIN_KEY protects POST /api/daily-calcs and /api/update-stats (sent as x-admin-key).
ADMIN_KEY=generate_a_long_random_string
# Account that auto-logged bets are saved under (must already exist in MongoDB)
ADMIN_EMAIL=you@example.com

# Optional: run the daily job from the server itself instead of GitHub Actions
ENABLE_SCHEDULED_JOBS=false
# Log every NBA/NFL/NHL game each day (takes precedence over DAILY_RANDOM_PICKS)
DAILY_ALL_PICKS=true
DAILY_KELLY_FRACTION=0.5
DAILY_CALC_CRON=17 15 * * *
