# Frontend Environment Variables
# Copy this file to .env.local for local development
# For Vercel deployment, set these in your Vercel project settings

# Backend API URL
# For local development: http://localhost:3000
# For production: Use your Render backend URL
VITE_BACKEND_URL=https://api.betgistics.com

# Stripe Payment Link for the paid plan (price/description managed in Stripe)
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/5kQ5kE2DOdxB1VidMjawo0O
